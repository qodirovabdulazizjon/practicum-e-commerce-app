<main class="container py-4">
  <h1 class="mb-4">Mahsulotlar</h1>

  <% if (products.length === 0) { %>
    <p>Hozircha mahsulotlar mavjud emas.</p>
  <% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% products.forEach(product => { %>
        <div class="col">
          <article class="card h-100">
            <img
              src="<%= product.imageUrl %>"
              class="card-img-top"
              alt="<%= product.name %>"
              style="height: 220px; object-fit: cover;"
            >
            <div class="card-body d-flex flex-column">
              <h2 class="card-title h5"><%= product.name %></h2>
              <p class="card-text"><%= product.description %></p>
              <p class="fw-bold mt-auto"><%= product.price %> so'm</p>
              <a href="/products/<%= product._id %>" class="btn btn-primary">Open</a>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  <% } %>
</main>